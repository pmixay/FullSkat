# FullSkat server configuration. Copy to .env and edit.
# Set at least one API key below (ANTHROPIC_API_KEY, OPENROUTER_API_KEY, KIMI_API_KEY). There is no
# provider switch: every provider with a key is checked on its own and offered to the watch while it
# works, so you can run them all at the same time. Speech is recognized on the watch, the server never
# gets audio.

# --- Chat -----------------------------------------------------------------------
# Let the model search the web when it needs fresh facts. This is the master switch; the watch
# can only turn it off per request, never on. Anthropic: the web_search server
# tool (must be enabled for your organization in the Claude Console); OpenRouter: the web plugin.
WEB_SEARCH=true
# Most searches one answer may run.
WEB_SEARCH_MAX_USES=3
# Stream the model's reasoning summary to the watch, shown collapsed under the answer.
SHOW_THINKING=true

# --- Anthropic (Claude API, enabled by its key) -----------------------------------
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default chat model; the watch may pick another one from the allowlist below.
ANTHROPIC_MODEL=claude-haiku-5-5
# Thinking depth sent as output_config.effort: low | medium | high | xhigh | max. Empty omits it.
ANTHROPIC_EFFORT=medium
ANTHROPIC_ALLOWED_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5,claude-fable-5-1
# Upper bound for one answer, including thinking tokens.
ANTHROPIC_MAX_TOKENS=4096
# Optional: a gateway or proxy in front of the Claude API.
ANTHROPIC_BASE_URL=

# --- OpenRouter (enabled by its key) ----------------------------------------------
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default model when OpenRouter is the first working provider.
OPENROUTER_MODEL=openai/gpt-6.1-terra
# Reasoning effort sent as {"reasoning": {"effort": ...}}. Leave empty to omit the field.
OPENROUTER_REASONING_EFFORT=high
# Comma-separated models the watch is allowed to request (400 model_not_allowed otherwise).
OPENROUTER_ALLOWED_MODELS=openai/gpt-6.1-terra,openai/gpt-6-luna
# Upper bound for one answer, including reasoning tokens.
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Kimi Code platform (enabled by its key) ----------------------------------------
# API key from the Kimi Code console: https://www.kimi.com/code/console (needs a Kimi Code membership;
# which models work depends on the plan, see https://www.kimi.com/code/docs/en/).
KIMI_API_KEY=
# Default model when Kimi Code is the first working provider.
KIMI_MODEL=k3.1-pro
# Kimi Code model ids: k3.1-pro and kimi-for-coding (which the Kimi Code docs call K2.8 Preview). Others
# the platform offers (k3, k3-256k, the *-highspeed variants) can be added here.
KIMI_ALLOWED_MODELS=k3.1-pro,kimi-for-coding
# Overseas: https://api.kimi.ai/coding/v1   Mainland China: https://api.kimi.com/coding/v1
KIMI_BASE_URL=https://api.kimi.ai/coding/v1
# Upper bound for one answer, including thinking (K3.1 Pro always thinks).
KIMI_MAX_TOKENS=8192
# Effort levels differ per model and the API has no endpoint that lists them. Both models take low,high,max:
# K3.1 Pro always thinks (max by default, thinking off is rejected), so it has no "none" level.
# Override per model with JSON ("" = not adjustable):
# KIMI_MODEL_EFFORTS={"k3.1-pro":"low,high,max","kimi-for-coding":"low,high,max"}
# Optional: take unknown models' levels from OpenRouter's public list (moonshotai/<model>; those ids and
# rules are the Moonshot API's, not Kimi Code's).
KIMI_EFFORTS_FROM_CATALOG=false
# Levels (none,minimal,low,medium,high,xhigh,max) for every model without its own entry; empty = not adjustable.
KIMI_EFFORTS=
KIMI_DEFAULT_EFFORT=

# --- Identity and storage -----------------------------------------------------
# Shown on the watch after pairing.
SERVER_NAME=FullSkat
# Where state.json (passcode hash + issued tokens) lives. Docker: /data (volume).
DATA_DIR=./data

# --- Rate limits --------------------------------------------------------------
# Pairing, per client IP.
PAIR_PER_MIN=5
PAIR_LOCK_FAILURES=10
PAIR_LOCK_MINUTES=15
# Chat, per token.
CHAT_PER_MIN=20
CHAT_PER_DAY=500

# --- Chat shaping -------------------------------------------------------------
# History sent upstream is trimmed to the last N messages / N characters.
MAX_HISTORY_MESSAGES=24
MAX_HISTORY_CHARS=12000

# --- Networking ---------------------------------------------------------------
# Set to true ONLY when running behind a reverse proxy (Caddy, nginx) that sets
# X-Forwarded-For; otherwise clients could spoof their IP for pairing limits.
TRUST_PROXY_HEADERS=false
# Bind address and port (python -m fullskat_server).
HOST=0.0.0.0
PORT=8080
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
