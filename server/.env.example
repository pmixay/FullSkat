# FullSkat server configuration. Copy to .env and edit.
# Every variable is optional except ANTHROPIC_API_KEY (chat) and, with the default
# STT_BACKEND=openrouter, OPENROUTER_API_KEY (speech recognition; the Claude API cannot
# transcribe audio, so pick another STT backend below if you do not want OpenRouter).

# --- Chat provider ------------------------------------------------------------
# anthropic (Claude API, default) | openrouter
LLM_PROVIDER=anthropic
# Let the model search the web when it needs fresh facts. Anthropic: the web_search server
# tool (must be enabled for your organization in the Claude Console); OpenRouter: the web plugin.
WEB_SEARCH=true
# Most searches one answer may run.
WEB_SEARCH_MAX_USES=3

# --- Anthropic (chat, LLM_PROVIDER=anthropic) ---------------------------------
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default chat model; the watch may pick another one from the allowlist below.
ANTHROPIC_MODEL=claude-haiku-5-5
# Thinking depth sent as output_config.effort: low | medium | high | xhigh | max. Empty omits it.
ANTHROPIC_EFFORT=medium
ANTHROPIC_ALLOWED_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5,claude-fable-5-1
# Upper bound for one answer, including thinking tokens.
ANTHROPIC_MAX_TOKENS=4096
# Optional: a gateway or proxy in front of the Claude API.
ANTHROPIC_BASE_URL=

# --- OpenRouter (chat with LLM_PROVIDER=openrouter, and the default STT backend) ---
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default chat model with LLM_PROVIDER=openrouter.
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Reasoning effort sent as {"reasoning": {"effort": ...}}. Leave empty to omit the field.
OPENROUTER_REASONING_EFFORT=high
# Comma-separated models the watch is allowed to request (400 model_not_allowed otherwise).
OPENROUTER_ALLOWED_MODELS=openai/gpt-5.6-luna,openai/gpt-5.6-luna-pro,openai/gpt-5.5,google/gemini-3.5-flash,anthropic/claude-sonnet-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Identity and storage -----------------------------------------------------
# Shown on the watch after pairing.
SERVER_NAME=FullSkat
# Where state.json (passcode hash + issued tokens) lives. Docker: /data (volume).
DATA_DIR=./data

# --- Speech to text -----------------------------------------------------------
# openrouter | faster_whisper | openai
STT_BACKEND=openrouter
# openrouter: audio-capable chat model used for transcription (same API key).
STT_OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# openai: any OpenAI-compatible /audio/transcriptions endpoint (OpenAI, Groq, ...).
STT_OPENAI_BASE_URL=https://api.openai.com/v1
STT_OPENAI_API_KEY=
STT_OPENAI_MODEL=whisper-large-v3-turbo
# faster_whisper: local model (pip install "fullskat-server[whisper]").
WHISPER_MODEL=large-v3-turbo
# auto | cpu | cuda
WHISPER_DEVICE=auto
# auto | int8 | float16 | float32 ...
WHISPER_COMPUTE_TYPE=auto

# --- Listening session --------------------------------------------------------
# How often partial transcripts are produced while the user speaks.
PARTIAL_INTERVAL_MS=1000
# Silence after speech that ends the utterance.
SILENCE_MS=5000
# Give up when nothing resembling speech was heard for this long.
NO_SPEECH_TIMEOUT_S=30
# Hard cap on one utterance.
MAX_UTTERANCE_S=60

# --- Rate limits --------------------------------------------------------------
# Pairing, per client IP.
PAIR_PER_MIN=5
PAIR_LOCK_FAILURES=10
PAIR_LOCK_MINUTES=15
# Chat and listen, per token.
CHAT_PER_MIN=20
CHAT_PER_DAY=500
LISTEN_PER_MIN=40
LISTEN_PER_DAY=1000

# --- Chat shaping -------------------------------------------------------------
# History sent upstream is trimmed to the last N messages / N characters.
MAX_HISTORY_MESSAGES=24
MAX_HISTORY_CHARS=12000
# Upper bound on the answer length (tokens).
MAX_COMPLETION_TOKENS=700

# --- Networking ---------------------------------------------------------------
# Set to true ONLY when running behind a reverse proxy (Caddy, nginx) that sets
# X-Forwarded-For; otherwise clients could spoof their IP for pairing limits.
TRUST_PROXY_HEADERS=false
# Bind address and port (python -m fullskat_server).
HOST=0.0.0.0
PORT=8080
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
