# FullSkat server configuration. Copy to .env and edit.
# Set at least one API key below (ANTHROPIC_API_KEY, OPENROUTER_API_KEY, KIMI_API_KEY, OPENAI_API_KEY). There is no
# provider switch: every provider with a key is checked on its own and offered to the apps while it
# works, so you can run them all at the same time. Speech is recognized on the phone and the watch, the
# server never gets audio.

# --- Chat -----------------------------------------------------------------------
# Let the model search the web when it needs fresh facts. This is the master switch; the apps
# can only turn it off per request (or in the user's preferences), never on. Anthropic: the web_search server
# tool (must be enabled for your organization in the Claude Console); OpenRouter: the
# openrouter:web_search server tool; OpenAI: the web_search tool; Kimi: $web_search.
WEB_SEARCH=true
# Most searches one answer may run.
WEB_SEARCH_MAX_USES=3
# Stream the model's reasoning summary to the apps, shown collapsed under the answer.
SHOW_THINKING=true
# Let the model draw figures (graphs, charts, geometry) with the draw tool; the apps render and animate them.
# Master switch: the apps can only turn it off per request.
FIGURES=true
# Most draw calls one answer may make.
FIGURES_MAX_PER_ANSWER=3

# --- Anthropic (Claude API, enabled by its key) -----------------------------------
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default chat model; the apps may pick another one from the allowlist below.
ANTHROPIC_MODEL=claude-haiku-5-5
# Thinking depth sent as output_config.effort: low | medium | high | xhigh | max. Empty omits it.
ANTHROPIC_EFFORT=medium
ANTHROPIC_ALLOWED_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5,claude-fable-5-1
# Upper bound for one answer, including thinking tokens.
ANTHROPIC_MAX_TOKENS=4096
# Optional: a gateway or proxy in front of the Claude API.
ANTHROPIC_BASE_URL=

# --- OpenRouter (enabled by its key) ----------------------------------------------
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default model when OpenRouter is the first working provider.
OPENROUTER_MODEL=openai/gpt-6.1-terra
# Reasoning effort sent as {"reasoning": {"effort": ...}}. Leave empty to omit the field.
OPENROUTER_REASONING_EFFORT=high
# Comma-separated models the apps are allowed to request (400 model_not_allowed otherwise).
OPENROUTER_ALLOWED_MODELS=openai/gpt-6.1-terra,openai/gpt-6-luna
# Upper bound for one answer, including reasoning tokens.
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Kimi Code platform (enabled by its key) ----------------------------------------
# API key from the Kimi Code console: https://www.kimi.com/code/console (needs a Kimi Code membership;
# which models work depends on the plan, see https://www.kimi.com/code/docs/en/).
KIMI_API_KEY=
# Default model when Kimi Code is the first working provider.
KIMI_MODEL=k3.1-pro
# Kimi Code model ids: k3.1-pro and kimi-for-coding (which the Kimi Code docs call K2.8 Preview). Others
# the platform offers (k3, k3-256k, the *-highspeed variants) can be added here.
KIMI_ALLOWED_MODELS=k3.1-pro,kimi-for-coding
# Overseas: https://api.kimi.ai/coding/v1   Mainland China: https://api.kimi.com/coding/v1
KIMI_BASE_URL=https://api.kimi.ai/coding/v1
# Upper bound for one answer, including thinking (K3.1 Pro always thinks).
KIMI_MAX_TOKENS=8192
# Effort levels differ per model and the API has no endpoint that lists them. Both models take low,high,max:
# K3.1 Pro always thinks (max by default, thinking off is rejected), so it has no "none" level.
# Override per model with JSON ("" = not adjustable):
# KIMI_MODEL_EFFORTS={"k3.1-pro":"low,high,max","kimi-for-coding":"low,high,max"}
# Optional: take unknown models' levels from OpenRouter's public list (moonshotai/<model>; those ids and
# rules are the Moonshot API's, not Kimi Code's).
KIMI_EFFORTS_FROM_CATALOG=false
# Levels (none,minimal,low,medium,high,xhigh,max) for every model without its own entry; empty = not adjustable.
KIMI_EFFORTS=
KIMI_DEFAULT_EFFORT=

# --- OpenAI / Codex LB gateway (enabled by its key) -------------------------------
# Direct OpenAI key or a dedicated proxy key created in the Codex LB dashboard.
OPENAI_API_KEY=
# Direct: https://api.openai.com/v1 ; local Codex LB: http://127.0.0.1:2455/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-terra
OPENAI_ALLOWED_MODELS=gpt-6.1-terra,gpt-6-luna,gpt-6.1-sol,gpt-6-astra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_TOKENS=4096
# Codex LB /models reports supported efforts. For gateways without this metadata,
# configure per model (empty string = not adjustable), for example:
# OPENAI_MODEL_EFFORTS={"gpt-6.1-terra":"low,medium,high,xhigh,max"}

# --- Identity and storage -----------------------------------------------------
# Shown in the apps after sign-up and linking.
SERVER_NAME=FullSkat
# Holds fullskat.db (SQLite: passcode hash, users, devices, dialogs, messages, preferences) and attachments/
# (images). Docker: /data (volume). Back it up; see README "Storage and backups". A pre-v2 state.json found
# here is imported once on start and renamed to state.json.migrated.
DATA_DIR=./data

# --- Rate limits --------------------------------------------------------------
# Sign-up (POST /v1/register), per client IP: attempts per minute, then a lockout after consecutive wrong
# passcodes. (The PAIR_ names are kept from the old pairing.)
PAIR_PER_MIN=5
PAIR_LOCK_FAILURES=10
PAIR_LOCK_MINUTES=15
# Code linking: starts per client IP; claims per user, with a lockout after consecutive wrong codes.
LINK_START_PER_MIN=20
LINK_CLAIM_PER_MIN=10
LINK_CLAIM_LOCK_FAILURES=5
LINK_CLAIM_LOCK_MINUTES=5
# Chat, per user (all of a person's devices together).
CHAT_PER_MIN=20
CHAT_PER_DAY=500
# Image uploads, per user.
UPLOADS_PER_HOUR=60

# --- Chat shaping -------------------------------------------------------------
# History sent upstream (from the dialog as stored on the server) is trimmed to the last N messages /
# N characters; an image counts as 1000 characters.
MAX_HISTORY_MESSAGES=24
MAX_HISTORY_CHARS=12000
# Images go to the model only with the newest N user messages that have any; older ones become "[image]".
MAX_HISTORY_IMAGE_MESSAGES=2

# --- Networking ---------------------------------------------------------------
# Set to true ONLY when running behind a reverse proxy (Caddy, nginx) that sets
# X-Forwarded-For; otherwise clients could spoof their IP for the per-IP limits.
TRUST_PROXY_HEADERS=false
# Bind address and port (python -m fullskat_server).
HOST=0.0.0.0
PORT=8080
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
